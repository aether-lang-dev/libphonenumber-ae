// Pharo binding tests. Canonical aeb grammar (no shell-out): pharo.sunit() loads
// the Tonel sources (via BaselineOfPhonenumberAe) into a throwaway image and runs
// the SUnit suite; env() exports the engine .so path the FFI binding dlopen's.
import bldr
import pharo
import bldr (dep, dep_artifact)
import pharo (baseline, tonel_dir, suite, env)

aeb(cap) {
    bldr.build() {
        prereq("pharo")
        dep("core/.build.ae")
        lib = dep_artifact("core/.build.ae", "shared_lib")
        pharo.sunit() {
            env("LIBPHONENUMBER_AE_LIB", lib)
            tonel_dir("src")
            baseline("PhonenumberAe")
            suite("PhonenumberAe")
        }
    }
}
