// Engine-level tests: the pure-Aether phonenumber engine, exercised through
// the `phonenumber` module directly (no C ABI, no binding). This is the
// behavioural spec — metadata plumbing, isPossibleNumber, isValidNumber (with
// the per-type national-number regexes), getNumberType, and formatting.
//
// This path proves the ENGINE, not the .so (the ABI is proven separately by
// core_tests/.abi.ae). It deps core/.build.ae only because that node generates
// the metadata tables (core/*metadata*.ae, gitignored) the engine compiles
// against. (There used to be a separate core/gen.build.ae for that, but two
// nodes in one directory share aeb's dir-keyed `build:core` label, so a DAG
// holding both ran the same label twice, concurrently, and both regenerated
// core/*.ae at once — the full presubmit went red on that race.)

import bldr
import bldr (dep)
import std.os

aeb(cap) {
    bldr.build() {
        dep("core/.build.ae")   // generates the metadata tables this gate compiles against
        root = _get("root")
        out = "${root}/target/pn_probe"

        _m = os.system("mkdir -p \"${root}/target\"")

        rc = os.system("cd \"${root}\" && ae build core_tests/probe.ae -o \"${out}\"")
        if rc != 0 {
            println("core_tests: failed to build probe.ae")
            return 1
        }

        rc2 = os.system("\"${out}\"")
        if rc2 != 0 {
            println("core_tests: probe.ae reported a failure")
            return 1
        }
        println("core_tests: PASS — engine behaviour")
        return 0
    }
}
