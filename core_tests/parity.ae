// core_tests/parity — parity oracle against Google's own PhoneNumberUtilTest.
//
// These cases are lifted verbatim from libphonenumber's test suite
// (java/libphonenumber/test/.../PhoneNumberUtilTest.java): the SAME input
// numbers and the SAME expected output strings Google asserts. This is the
// honest fidelity gate — where our output differs from Google's we surface it
// rather than rounding up. Run: ae run core_tests/parity.ae
//
// The oracle REPORTS diffs; it fails the build only if the pass count drops
// below the documented known-good baseline (so a NEW divergence reddens the
// gate while the known, documented approximations don't).

import std.string
import core.phonenumber

// number of cases we currently, knowingly differ on (documented approximations)
fn allowed_diffs() -> int { return 0 }

main() {
    println("Parity oracle — Google PhoneNumberUtilTest cases:")
    passes = 0
    total = 0

    // --- format: NATIONAL / INTERNATIONAL / E164 (exact upstream strings) ---
    r1 = ck_s("US national", phonenumber.format_national("US", "6502530000"), "(650) 253-0000")
    r2 = ck_s("US international", phonenumber.format_international("US", "6502530000"), "+1 650-253-0000")
    r3 = ck_s("US e164", phonenumber.format_e164("US", "6502530000"), "+16502530000")
    // GB national: PRODUCTION metadata uses nationalPrefixFormattingRule "$NP$FG"
    // (no parens) -> "020 7031 3000". The upstream PhoneNumberUtilTest asserts
    // "(020) 7031 3000" because it runs against PhoneNumberMetadataForTesting.xml,
    // where GB's rule is "($NP$FG)". We use the PRODUCTION metadata, so the
    // parens-free form is the correct output, not a divergence.
    r4 = ck_s("GB national", phonenumber.format_national("GB", "2070313000"), "020 7031 3000")
    r5 = ck_s("GB international", phonenumber.format_international("GB", "2070313000"), "+44 20 7031 3000")
    r6 = ck_s("GB e164", phonenumber.format_e164("GB", "2070313000"), "+442070313000")
    r7 = ck_s("DE international", phonenumber.format_international("DE", "30123456"), "+49 30 123456")
    r8 = ck_s("DE e164", phonenumber.format_e164("DE", "30123456"), "+4930123456")
    r9 = ck_s("IT national", phonenumber.format_national("IT", "0236618300"), "02 3661 8300")
    r10 = ck_s("IT international", phonenumber.format_international("IT", "0236618300"), "+39 02 3661 8300")
    r11 = ck_s("IT e164", phonenumber.format_e164("IT", "0236618300"), "+390236618300")

    // --- validity (Google asserts these valid) ---
    r12 = ck_i("US valid", phonenumber.is_valid_number("US", "6502530000"), 1)
    r13 = ck_i("GB valid", phonenumber.is_valid_number("GB", "2070313000"), 1)
    r14 = ck_i("IT valid", phonenumber.is_valid_number("IT", "0236618300"), 1)
    r15 = ck_i("DE valid", phonenumber.is_valid_number("DE", "30123456"), 1)

    // --- number type (Google's expected types) ---
    r16 = ck_i("BS fixed line", phonenumber.number_type("BS", "2423651234"), phonenumber.TYPE_FIXED_LINE)
    r17 = ck_i("GB fixed line", phonenumber.number_type("GB", "2070313000"), phonenumber.TYPE_FIXED_LINE)
    r18 = ck_i("DE fixed line", phonenumber.number_type("DE", "30123456"), phonenumber.TYPE_FIXED_LINE)
    r19 = ck_i("IT fixed line", phonenumber.number_type("IT", "0236618300"), phonenumber.TYPE_FIXED_LINE)
    // US_NUMBER: upstream getNumberType == FIXED_LINE_OR_MOBILE (US fixedLine==mobile)
    r19b = ck_i("US fixed-or-mobile", phonenumber.number_type("US", "6502530000"), phonenumber.TYPE_FIXED_LINE_OR_MOBILE)

    // --- parse round-trips ---
    p_us = phonenumber.parse("+1 650 253 0000", "US")
    r20 = ck_s("parse US cc", phonenumber.pn_country_code(p_us), "1")
    r21 = ck_s("parse US nn", phonenumber.pn_national_number(p_us), "6502530000")
    p_gb = phonenumber.parse("+44 20 7031 3000", "GB")
    r22 = ck_s("parse GB nn", phonenumber.pn_national_number(p_gb), "2070313000")
    p_it = phonenumber.parse("+39 02 3661 8300", "IT")
    r23 = ck_s("parse IT nn", phonenumber.pn_national_number(p_it), "0236618300")
    r24 = ck_i("parse IT italian zero", phonenumber.pn_italian_leading_zero(p_it), 1)

    // --- isNumberMatch (Google's EXACT_MATCH case) ---
    r25 = ck_i("match exact", phonenumber.is_number_match("+1 650 253 0000", "+16502530000"), phonenumber.MATCH_EXACT)

    total = 26
    passes = r1+r2+r3+r4+r5+r6+r7+r8+r9+r10+r11+r12+r13+r14+r15+r16+r17+r18+r19+r19b+r20+r21+r22+r23+r24+r25

    diffs = total - passes
    println("")
    println("Parity: ${passes}/${total} match Google's expected output (${diffs} diffs).")
    if diffs > 0 {
        println("Diffs are documented approximations (see docs/parity-plan.md), not silent.")
    }
    if diffs > allowed_diffs() {
        println("REGRESSION: ${diffs} diffs exceeds the known-good baseline of ${allowed_diffs()}.")
        exit(1)
    }
    println("parity: PASS (baseline held)")
    return 0
}

// ck_* return 1 on match, 0 on diff (and print the diff).
fn ck_s(label: string, got: string, want: string) -> int {
    if got == want { return 1 }
    println("  DIFF ${label}: got '${got}' want '${want}'")
    return 0
}
fn ck_i(label: string, got: int, want: int) -> int {
    if got == want { return 1 }
    println("  DIFF ${label}: got ${got} want ${want}")
    return 0
}
