// PhoneNumberToCarrierMapper engine gate.
import bldr
import std.os
aeb(cap) {
    bldr.build() {
        root = _get("root")
        out = "${root}/target/pn_carrier_probe"
        _m = os.system("mkdir -p \"${root}/target\"")
        rc = os.system("cd \"${root}\" && ae build core_tests/carrier_probe.ae -o \"${out}\"")
        if rc != 0 { println("core_tests: failed to build carrier_probe.ae"); return 1 }
        rc2 = os.system("\"${out}\"")
        if rc2 != 0 { println("core_tests: carrier mapper probe failed"); return 1 }
        println("core_tests: PASS — PhoneNumberToCarrierMapper behaviour")
        return 0
    }
}
