// Lua binding tests (a Lua 5.4 C extension that dlopen's the engine). Canonical
// aeb grammar (no shell-out): lua.conformance() compiles the C extension, builds
// the host, and runs the assertion suite; env() exports the engine .so path the
// extension dlopen's (LIBPHONENUMBER_AE_LIB). Mirrors the selenium lua binding.
import bldr
import lua
import bldr (dep, dep_artifact)
import lua (env, c_source, ext_output, host_source, test_file)

aeb(cap) {
    bldr.build() {
        dep("core/.build.ae")
        lib = dep_artifact("core/.build.ae", "shared_lib")
        lua.conformance() {
            env("LIBPHONENUMBER_AE_LIB", lib)
            c_source("src/phonenumber_ae.c")
            ext_output("phonenumber_ae_native.so")
            host_source("host/lua54.c")
            test_file("test/conformance.lua")
        }
    }
}
