// Elixir binding tests. Canonical aeb grammar (no shell-out): elixir.test() runs
// `mix test` against the shared BEAM NIF built by erlang/.build.ae; env() exports
// ERL_LIBS + the nif_ebin + the engine .so path the NIF dlopen's. Mirrors the
// selenium elixir binding.
import bldr
import elixir
import bldr (dep, dep_artifact)
import elixir (env)

aeb(cap) {
    bldr.build() {
        prereq("elixir")
        dep("core/.build.ae")
        dep("erlang/.build.ae")
        lib  = dep_artifact("core/.build.ae", "shared_lib")
        libs = dep_artifact("erlang/.build.ae", "erl_libs")
        app  = dep_artifact("erlang/.build.ae", "erlang_app")
        elixir.test() {
            env("ERL_LIBS", libs)
            // mix does not honour ERL_LIBS for its own path resolution, so the
            // NIF app dir is passed explicitly (our loader reads it).
            env("LIBPHONENUMBER_AE_BEAM_APP", app)
            env("LIBPHONENUMBER_AE_LIB", lib)
        }
    }
}
