// Gleam binding tests. Canonical aeb grammar (no shell-out): gleam.test() runs
// `gleam test` on the erlang target against the shared BEAM NIF built by
// erlang/.build.ae; env() exports ERL_LIBS (gleam honours it, unlike mix) plus
// the engine .so path the NIF dlopen's. Mirrors the selenium gleam binding.
import bldr
import gleam
import bldr (dep, dep_artifact)
import gleam (env)

aeb(cap) {
    bldr.build() {
        prereq("gleam")
        dep("core/.build.ae")
        dep("erlang/.build.ae")
        lib  = dep_artifact("core/.build.ae", "shared_lib")
        libs = dep_artifact("erlang/.build.ae", "erl_libs")
        gleam.test() {
            env("ERL_LIBS", libs)
            env("LIBPHONENUMBER_AE_LIB", lib)
        }
    }
}
