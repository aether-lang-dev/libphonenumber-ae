// The Java binding's DISTRIBUTION artifact: a self-contained fat jar.
//
// Produces a hand-to-someone jar under target/dist/: the binding classes PLUS
// the engine .so bundled at /native/ inside the jar. Native.openLibrary()
// extracts /native/<lib> from the classpath to a temp file (Panama can't dlopen
// a jar entry), so the jar runs with no LIBPHONENUMBER_AE_LIB and no external
// .so. One .so per jar => the jar is current-OS-only.
//
// KNOWN LIMITATION (aeb): java.package_jar() RECOMPILES the sources instead of
// packaging java/.build.ae's already-compiled classes — so the Java sources are
// compiled twice (once for the tests + JVM-family, once here), and the jar's
// bytecode is the-same-as-tested only because both compiles read identical
// sources/flags, not structurally. Every other JVM build system separates
// compile (a node) from jar (a downstream step that consumes the classes); the
// fix belongs in aeb (package_jar should accept a pre-compiled classpath and
// skip its javac). Filed at ../aeb/asks/. Once landed, this node should dep
// java/.build.ae and package its classes rather than recompiling.
//
// The engine .so comes from core/.build.ae's shared_lib artifact (dep'd), so the
// jar always bundles the freshly-built engine. JDK 22+ (FFM/Panama).
import bldr
import java
import std.os
import bldr (dep, dep_artifact, _get)
import java (jar_name, native_resource, release)

aeb(cap) {
    bldr.build() {
        dep("core/.build.ae")
        lib = dep_artifact("core/.build.ae", "shared_lib")
        root = _get("root")
        dist = "${root}/target/dist"
        _m = os.system("mkdir -p \"${dist}\"")

        java.package_jar() {
            jar_name("phonenumber-ae.jar")
            release("22")
            // Bundle the engine .so as /native/libphonenumber_ae.so inside the jar.
            native_resource(lib, "native/libphonenumber_ae.so")
        }

        // package_jar publishes under target/jar/java/; collect the artifact into
        // the monorepo's single distribution dir so every binding's dist lands in
        // one place a consumer can grab.
        built = "${root}/target/jar/java/phonenumber-ae.jar"
        rc = os.system("cp \"${built}\" \"${dist}/phonenumber-ae.jar\"")
        if rc != 0 { println("java dist: failed to copy jar into target/dist"); return 1 }
        println("java dist: target/dist/phonenumber-ae.jar (fat jar, engine bundled at /native/)")
        return 0
    }
}
