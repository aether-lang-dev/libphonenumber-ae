// Python binding tests (ctypes). The loader honors LIBPHONENUMBER_AE_LIB, which
// we point at the shared engine artifact this node deps.
import bldr
import std.os

aeb(cap) {
    bldr.build() {
        dep("core/.build.ae")
        lib = dep_artifact("core/.build.ae", "shared_lib")
        root = _get("root")

        // PYTEST_DISABLE_PLUGIN_AUTOLOAD keeps a developer's third-party pytest
        // plugins out of the run so an unrelated broken plugin can't fail the
        // suite before a single test of ours executes.
        rc = os.system("cd \"${root}/python\" && LIBPHONENUMBER_AE_LIB=\"${lib}\" PYTHONPATH=\"${root}/python\" PYTEST_DISABLE_PLUGIN_AUTOLOAD=1 python3 -m pytest test -q -p no:cacheprovider")
        if rc != 0 {
            println("python: pytest reported failures (is pytest installed?)")
            return 1
        }
        println("python: PASS — v2 conformance (parse, formats, AsYouType, matcher)")
        return 0
    }
}
