// Python binding tests (ctypes). Canonical aeb grammar (no shell-out):
//   prereq   — skip cleanly when python is absent (no false pass)
//   pip      — declare pytest as a venv dependency
//   install  — build the aeb-managed venv (pytest + this package)
//   pytest   — run the suite; env() exports the engine .so path the ctypes
//              loader reads (LIBPHONENUMBER_AE_LIB), plus disables third-party
//              pytest plugin autoload so a broken box plugin can't fail the run.
// Mirrors the selenium/ python binding's proven pattern.
import bldr
import python
import bldr (dep, dep_artifact, _get)
import python (pip, install, pytest, env, prereq)

aeb(cap) {
    bldr.build() {
        prereq("python:3")
        dep("core/.build.ae")
        lib = dep_artifact("core/.build.ae", "shared_lib")
        root = _get("root")
        python.install() {
            pip("pytest")
        }
        python.pytest() {
            env("LIBPHONENUMBER_AE_LIB", lib)
            env("PYTHONPATH", "${root}/python")
            env("PYTEST_DISABLE_PLUGIN_AUTOLOAD", "1")
        }
    }
}
