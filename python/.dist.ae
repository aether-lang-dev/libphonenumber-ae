// The Python binding's DISTRIBUTION artifact: a self-contained wheel.
//
// Unlike python/.tests.ae (which runs pytest against a loose engine .so pointed
// at by LIBPHONENUMBER_AE_LIB), this node produces a hand-to-someone wheel under
// target/dist/: the pure-Python binding PLUS the engine .so bundled at
// phonenumber_ae/native/libphonenumber_ae.so inside the wheel. _native.py's
// loader already probes native/ beside the package, so the wheel runs with no
// LIBPHONENUMBER_AE_LIB and no external .so to place.
//
// One .so per wheel => the wheel is current-OS-only (the .so is this box's
// platform). setup.py already declares package_data={"phonenumber_ae":
// ["native/*"]}, so copying the freshly-built engine into native/ before the
// build is all that is needed for it to be packaged.
//
// The engine .so comes from core/.build.ae's shared_lib artifact (dep'd), so the
// wheel always bundles the freshly-built engine.
import bldr
import std.os
import bldr (dep, dep_artifact, _get)

aeb(cap) {
    bldr.build() {
        dep("core/.build.ae")
        lib = dep_artifact("core/.build.ae", "shared_lib")
        root = _get("root")
        dist = "${root}/target/dist"
        _m = os.system("mkdir -p \"${dist}\"")

        // Skip honestly rather than fail the DAG when the toolchain is absent.
        have = os.system("command -v python3 >/dev/null 2>&1")
        if have != 0 {
            println("python dist: SKIPPED — python3 not installed")
            return 0
        }
        hb = os.system("python3 -c 'import build' >/dev/null 2>&1")
        if hb != 0 {
            println("python dist: SKIPPED — python 'build' module not installed (pip install build)")
            return 0
        }

        // Bundle the freshly-built engine so the wheel is self-contained; the
        // package_data glob in setup.py packages native/* into the wheel.
        pkgnative = "${root}/python/phonenumber_ae/native"
        _mk = os.system("mkdir -p \"${pkgnative}\"")
        rcc = os.system("cp \"${lib}\" \"${pkgnative}/libphonenumber_ae.so\"")
        if rcc != 0 { println("python dist: failed to vendor engine .so into phonenumber_ae/native"); return 1 }

        // Build the wheel into python/target/dist_wheel, then collect it into the
        // monorepo's single distribution dir. A dedicated outdir keeps this run's
        // wheel unambiguous to locate.
        outdir = "${root}/python/target/dist_wheel"
        _mo = os.system("rm -rf \"${outdir}\" && mkdir -p \"${outdir}\"")
        rcb = os.system("cd \"${root}/python\" && python3 -m build --wheel --no-isolation --outdir \"${outdir}\" >/dev/null 2>&1")
        if rcb != 0 {
            // Retry without --no-isolation in case build backend deps must be
            // fetched into an isolated env.
            rcb = os.system("cd \"${root}/python\" && python3 -m build --wheel --outdir \"${outdir}\" >/dev/null 2>&1")
        }
        if rcb != 0 { println("python dist: `python3 -m build --wheel` failed"); return 1 }

        rcp = os.system("cp \"${outdir}\"/*.whl \"${dist}/\"")
        if rcp != 0 { println("python dist: no wheel produced to copy into target/dist"); return 1 }

        println("python dist: target/dist/*.whl (wheel, engine bundled at phonenumber_ae/native/)")
        return 0
    }
}
