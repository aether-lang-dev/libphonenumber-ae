rows() -> ptr {
    b = blob()
    l = list.new()
    start = 0
    n = string.length(b)
    for (i = 0; i <= n; i++) {
        at = 0
        if i == n { at = 1 } else { if string.char_at(b, i) == 10 { at = 1 } }
        if at == 1 {
            if i > start { list.add(l, string.substring(b, start, i)) }
            start = i + 1
        }
    }
    return l
}
