// core.gen.generate_geo — compile the English geocoding prefix map into a
// pure-Aether table for the PhoneNumberOfflineGeocoder side-library.
//
// Run offline when the data changes (from the repo root):
//     ae run core/gen/generate_geo.ae > core/geocoder_metadata.ae
//
// Reads the pristine, in-tree resources/geocoding/en/<cc>.txt files (Google's
// own, Apache-2.0). Each file is one "prefix|Description" entry per line
// (comments begin with '#'); the prefix is cc-inclusive leading E.164 digits.
// English descriptions only (the default consumer slice; ~269k entries, 6.7 MB).
//
// Stored as ONE newline-joined string blob (rows "cc<0x1F>prefix<0x1F>desc"),
// like the carrier table: too many entries for the compiler's per-function
// statement cap as list.add calls, but a single 7 MB string constant compiles
// in ~0.4s. The engine scans it with the cached-length accessors (char_at_n /
// substring_n) so a lookup is O(n), not O(n^2). Longest-prefix match.

import std.string
import std.list
import std.file

main() {
    println("// core.geocoder_metadata — GENERATED, do not edit.")
    println("//")
    println("// Produced by core/gen/generate_geo.ae from")
    println("// resources/geocoding/en/<cc>.txt (Apache-2.0, (c) The Libphonenumber Authors).")
    println("//")
    println("// One newline-joined blob of \"cc<0x1F>prefix<0x1F>desc\" rows (English).")
    println("// Longest-prefix match; see core/geocoder.ae.")
    println("")
    println("import std.string")
    println("")
    println("exports(blob)")
    println("")
    print("blob() -> string { return \"")

    for (cc = 1; cc <= 999; cc++) {
        path = "resources/geocoding/en/${string.from_int(cc)}.txt"
        text, ferr = file.read(path)
        if ferr != "" { continue }
        emit_blob_lines(text, string.from_int(cc))
    }

    println("\" }")
    return 0
}

// Append one geocoding file's lines to the blob as "cc\x1fprefix\x1fdesc\n" each,
// escaped for the .ae string literal.
fn emit_blob_lines(text: string, ccs: string) {
    n = string.length(text)
    start = 0
    for (i = 0; i <= n; i++) {
        at = 0
        if i == n { at = 1 } else { if string.char_at(text, i) == 10 { at = 1 } }
        if at == 1 {
            line = string.trim(string.substring(text, start, i))
            start = i + 1
            if string.length(line) == 0 { continue }
            if string.char_at(line, 0) == 35 { continue }   // '#'
            bar = string.index_of(line, "|")
            if bar < 0 { continue }
            prefix = string.substring(line, 0, bar)
            desc = string.substring(line, bar + 1, string.length(line))
            sep = string.from_char(31)
            row = "${ccs}${sep}${prefix}${sep}${desc}"
            print(esc(row))
            print("\\n")
        }
    }
}

fn esc(s: string) -> string {
    bs = string.from_char(92)
    q = string.from_char(34)
    out = ""
    n = string.length(s)
    for (i = 0; i < n; i++) {
        c = string.char_at(s, i)
        if c == 34 { out = string.concat(out, string.concat(bs, q)) }
        else if c == 92 { out = string.concat(out, string.concat(bs, bs)) }
        else if c == 31 { out = string.concat(out, string.concat(bs, "x1f")) }
        else { out = string.concat(out, string.substring(s, i, i + 1)) }
    }
    return out
}
