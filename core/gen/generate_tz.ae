// core.gen.generate_tz — compile the timezone prefix map into a pure-Aether table
// for the PhoneNumberToTimeZonesMapper side-library.
//
// Run offline when the data changes (from the repo root):
//     ae run core/gen/generate_tz.ae > core/timezone_metadata.ae
//
// Reads the pristine, in-tree resources/timezones/map_data.txt (Google's own,
// Apache-2.0). That file is one "prefix|tz1&tz2&..." entry per line (comments
// begin with '#'); the prefix is the leading digits of an E.164 number (country
// code + area), the value is an '&'-joined list of IANA timezone ids. The engine
// does a longest-prefix match over these.
//
// Row layout, 0x1F-separated: prefix | tz1&tz2&...

import std.string
import std.list
import std.file

main() {
    text, ferr = file.read("resources/timezones/map_data.txt")
    if ferr != "" {
        println("// ERROR reading timezone map: ${ferr}")
        return 1
    }

    println("// core.timezone_metadata — GENERATED, do not edit.")
    println("//")
    println("// Produced by core/gen/generate_tz.ae from")
    println("// resources/timezones/map_data.txt (Apache-2.0, (c) The Libphonenumber Authors).")
    println("//")
    println("// Row (0x1F-separated): prefix | tz1&tz2&...  (prefix = leading E.164 digits;")
    println("// value = '&'-joined IANA timezone ids). Longest-prefix match. See core/timezone.ae.")
    println("")
    println("import std.list")
    println("")
    println("exports(rows, SEP)")
    println("")
    println("SEP() -> string { return \"\\x1f\" }")
    println("")
    println("rows() -> ptr {")
    println("    l = list.new()")

    // Split the file into lines and emit one row per non-comment line.
    n = string.length(text)
    start = 0
    for (i = 0; i <= n; i++) {
        at = 0
        if i == n { at = 1 } else { if string.char_at(text, i) == 10 { at = 1 } }  // '\n'
        if at == 1 {
            line = string.trim(string.substring(text, start, i))
            start = i + 1
            if string.length(line) == 0 { continue }
            if string.char_at(line, 0) == 35 { continue }   // '#' comment
            bar = string.index_of(line, "|")
            if bar < 0 { continue }
            prefix = string.substring(line, 0, bar)
            tzs = string.substring(line, bar + 1, string.length(line))
            sep = string.from_char(31)
            row = "${prefix}${sep}${tzs}"
            println("    list.add(l, \"${esc(row)}\")")
        }
    }

    println("    return l")
    println("}")
    return 0
}

fn esc(s: string) -> string {
    bs = string.from_char(92)
    q = string.from_char(34)
    out = ""
    n = string.length(s)
    for (i = 0; i < n; i++) {
        c = string.char_at(s, i)
        if c == 34 { out = string.concat(out, string.concat(bs, q)) }
        else if c == 92 { out = string.concat(out, string.concat(bs, bs)) }
        else if c == 31 { out = string.concat(out, string.concat(bs, "x1f")) }
        else { out = string.concat(out, string.substring(s, i, i + 1)) }
    }
    return out
}
