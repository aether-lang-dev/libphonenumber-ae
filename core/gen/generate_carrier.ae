// core.gen.generate_carrier — compile the English carrier prefix map into a
// pure-Aether table for the PhoneNumberToCarrierMapper side-library.
//
// Run offline when the data changes (from the repo root):
//     ae run core/gen/generate_carrier.ae > core/carrier_metadata.ae
//
// Reads the pristine, in-tree resources/carrier/en/<cc>.txt files (Google's own,
// Apache-2.0). Each file is one "prefix|CarrierName" entry per line (comments
// begin with '#'); the prefix is cc-inclusive leading E.164 digits. We carry the
// English names only (the largest, default consumer slice); other languages can
// be added later the same way.
//
// Row layout, 0x1F-separated: cc | prefix | CarrierName
// The explicit leading cc lets the engine narrow to one country's entries before
// the longest-prefix scan — important because en/ has ~29k entries total (a flat
// per-call linear scan would be slow), while any single cc is far smaller.

import std.string
import std.list
import std.file
import std.os

main() {
    // Language argument (ISO code matching resources/carrier/<lang>/), default en.
    // Usage (arg needs a compiled run; ae run does not forward argv):
    //   ae build core/gen/generate_carrier.ae -o /tmp/gc && /tmp/gc de > core/carrier_metadata_de.ae
    lang = "en"
    if os.args_count() > 1 { lang = os.args_get(1) }

    println("// core.carrier_metadata_${lang} — GENERATED, do not edit.")
    println("//")
    println("// Produced by core/gen/generate_carrier.ae from")
    println("// resources/carrier/${lang}/<cc>.txt (Apache-2.0, (c) The Libphonenumber Authors).")
    println("//")
    println("// Row (0x1F-separated): cc | prefix | CarrierName (${lang} names). Longest-")
    println("// prefix match within a country code. See core/carrier.ae.")
    println("")
    println("import std.string")
    println("import std.list")
    println("")
    println("exports(rows, SEP, blob)")
    println("")
    println("SEP() -> string { return \"\\x1f\" }")
    println("")

    // The Aether compiler caps the number of statements in a single function
    // (~12.5k list.add calls), and a very large module of them won't type-check.
    // A single STRING CONSTANT is one token, immune to that cap — so we emit the
    // whole table as one newline-joined blob and split it at runtime. Fields
    // within a row stay 0x1F-separated (cc | prefix | name); rows are '\n'-joined.
    // (Verified: the full ~29k-entry blob compiles in ~0.1s; the list.add form
    // does not compile at all. See core/carrier.ae for the runtime split.)
    println("// The whole table as one newline-joined blob (see rows() below).")
    print("blob() -> string { return \"")

    for (cc = 1; cc <= 999; cc++) {
        path = "resources/carrier/${lang}/${string.from_int(cc)}.txt"
        text, ferr = file.read(path)
        if ferr != "" { continue }
        emit_blob_lines(text, string.from_int(cc))
    }

    println("\" }")
    println("")
    // rows() splits the blob into a list on demand.
    println("rows() -> ptr {")
    println("    b = blob()")
    println("    l = list.new()")
    println("    start = 0")
    println("    n = string.length(b)")
    println("    for (i = 0; i <= n; i++) {")
    println("        at = 0")
    println("        if i == n { at = 1 } else { if string.char_at(b, i) == 10 { at = 1 } }")
    println("        if at == 1 {")
    println("            if i > start { list.add(l, string.substring(b, start, i)) }")
    println("            start = i + 1")
    println("        }")
    println("    }")
    println("    return l")
    println("}")

    return 0
}

// Append one carrier file's lines to the blob literal as "cc\x1fprefix\x1fname\n"
// each, escaped for the .ae string literal (0x1F -> \x1f, \n -> \n, quotes/\\).
fn emit_blob_lines(text: string, ccs: string) {
    n = string.length(text)
    start = 0
    for (i = 0; i <= n; i++) {
        at = 0
        if i == n { at = 1 } else { if string.char_at(text, i) == 10 { at = 1 } }
        if at == 1 {
            line = string.trim(string.substring(text, start, i))
            start = i + 1
            if string.length(line) == 0 { continue }
            if string.char_at(line, 0) == 35 { continue }   // '#'
            bar = string.index_of(line, "|")
            if bar < 0 { continue }
            prefix = string.substring(line, 0, bar)
            name = string.substring(line, bar + 1, string.length(line))
            sep = string.from_char(31)
            row = "${ccs}${sep}${prefix}${sep}${name}"
            // print the escaped row followed by a literal \n row-separator.
            print(esc(row))
            print("\\n")
        }
    }
}

fn esc(s: string) -> string {
    bs = string.from_char(92)
    q = string.from_char(34)
    out = ""
    n = string.length(s)
    for (i = 0; i < n; i++) {
        c = string.char_at(s, i)
        if c == 34 { out = string.concat(out, string.concat(bs, q)) }
        else if c == 92 { out = string.concat(out, string.concat(bs, bs)) }
        else if c == 31 { out = string.concat(out, string.concat(bs, "x1f")) }
        else { out = string.concat(out, string.substring(s, i, i + 1)) }
    }
    return out
}
