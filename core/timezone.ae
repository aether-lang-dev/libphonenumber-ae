// core.timezone — a pure-Aether PhoneNumberToTimeZonesMapper (the timezone
// side-library of libphonenumber).
//
// Compiled from resources/timezones/map_data.txt (via core/gen/generate_tz.ae)
// into core/timezone_metadata.ae: a prefix -> timezone-list map. Answers
// getTimeZonesForNumber / getTimeZonesForGeographicalNumber by longest-prefix
// match over the E.164 digits (country code + national number).
//
// The input is a phone number's full E.164 digit string ("<cc><national>", no
// '+'). For a raw (region, input) pair, the phonenumber engine's parse +
// format_e164 produces that; the ABI layer does the joining, so this module
// takes the E.164 digits directly.

import std.string
import std.list
import core.timezone_metadata

exports(
    time_zones_for_e164, time_zone_count_for_e164, time_zone_at_for_e164,
    unknown_time_zone
)

const F_PREFIX = 0
const F_TZS = 1

fn sep_char() -> int { return 31 }
fn dup(s: string) -> string { return string.concat(s, "") }

fn field(row: string, idx: int) -> string {
    sc = sep_char()
    start = 0
    seen = 0
    n = string.length(row)
    for (i = 0; i <= n; i++) {
        at = 0
        if i == n { at = 1 } else { if string.char_at(row, i) == sc { at = 1 } }
        if at == 1 {
            if seen == idx { return string.substring(row, start, i) }
            seen = seen + 1
            start = i + 1
        }
    }
    return ""
}

// libphonenumber's "unknown" timezone sentinel.
unknown_time_zone() -> string { return "Etc/Unknown" }

fn digits(s: string) -> string {
    out = ""
    n = string.length(s)
    for (i = 0; i < n; i++) {
        c = string.char_at(s, i)
        if c >= 48 && c <= 57 { out = "${out}${string.substring(s, i, i + 1)}" }
    }
    return out
}

// The '&'-joined timezone list for the LONGEST prefix of `e164` present in the
// map, or "" if none. e164 is the full country-code+national digit string.
fn tz_list_for(e164: string) -> string {
    d = digits(e164)
    if string.length(d) == 0 { return "" }
    rows = timezone_metadata.rows()
    n = list.size(rows)
    best = ""
    best_len = -1
    // Try each map prefix; keep the longest that is a prefix of `d`.
    for (i = 0; i < n; i++) {
        r, _ = list.get(rows, i)
        pfx = field(r, F_PREFIX)
        pl = string.length(pfx)
        if pl <= string.length(d) && pl > best_len {
            if string.substring(d, 0, pl) == pfx {
                best = dup(field(r, F_TZS))
                best_len = pl
            }
        }
    }
    list.free(rows)
    return best
}

// The number of timezones for an E.164 number (0 = only the unknown zone).
time_zone_count_for_e164(e164: string) -> int {
    tzs = tz_list_for(e164)
    if string.length(tzs) == 0 { return 0 }
    return count_amp(tzs) + 1
}

// The idx-th timezone id for an E.164 number, or the unknown zone out of range.
time_zone_at_for_e164(e164: string, idx: int) -> string {
    tzs = tz_list_for(e164)
    if string.length(tzs) == 0 { return unknown_time_zone() }
    v = amp_at(tzs, idx)
    if string.length(v) == 0 { return unknown_time_zone() }
    return v
}

// Convenience: the full '&'-joined list (or the unknown zone if none).
time_zones_for_e164(e164: string) -> string {
    tzs = tz_list_for(e164)
    if string.length(tzs) == 0 { return unknown_time_zone() }
    return tzs
}

// How many '&'-separated entries `s` has beyond the first (so total = +1).
fn count_amp(s: string) -> int {
    n = string.length(s)
    c = 0
    for (i = 0; i < n; i++) { if string.char_at(s, i) == 38 { c = c + 1 } }  // '&'
    return c
}

// The idx-th '&'-separated entry of `s`.
fn amp_at(s: string, idx: int) -> string {
    start = 0
    seen = 0
    n = string.length(s)
    for (i = 0; i <= n; i++) {
        at = 0
        if i == n { at = 1 } else { if string.char_at(s, i) == 38 { at = 1 } }
        if at == 1 {
            if seen == idx { return string.substring(s, start, i) }
            seen = seen + 1
            start = i + 1
        }
    }
    return ""
}
