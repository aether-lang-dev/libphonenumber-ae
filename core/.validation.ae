// Validation-only variant of the core — the minimum build: full core
// PhoneNumberUtil surface (parse, validate, format, match, AsYouType, matcher)
// with NONE of the side-library data blobs. ~320 KB vs the full ~8 MB (26x
// smaller), because the geocoder/carrier/timezone/short-number metadata is not
// linked in.
//
// core/embed_validation.ae is GENERATED by core/gen/assemble_embed.sh (base only,
// no feature fragments); this node runs the metadata generator and that assembler
// inline before the builder (same ordering rule as core/.build.ae), so it builds
// from a fresh checkout.
//
// Named .validation.ae (type "validation", label "validation:core"), NOT
// validation.build.ae: a non-dot file is type "build", so the old name took the
// same "core" label as core/.build.ae, and aeb's per-label visited-set dedup
// then ran one node and skipped the other's builder in any graph holding both. To compose a different subset (e.g. base + geocoder),
// run e.g. `core/gen/assemble_embed.sh core/embed_geo.ae geo` and point a build
// node at it, or build directly:
//   ae build --emit=lib --with=extern core/embed_geo.ae --extra core/_embed_support.c -o out.so
//
// The default core/.build.ae builds the FULL variant (all features).

import bldr
import aether
import aether (source, extra_source, output, caps)
import std.os
import bldr (_get)

aeb(cap) {
    bldr.build() {
        root = _get("root")
        rc0 = os.system("cd \"${root}\" && core/gen/generate_metadata.sh en")
        if rc0 != 0 { println("core: generate_metadata.sh failed"); return 1 }
        rc1 = os.system("cd \"${root}\" && core/gen/assemble_embed.sh core/embed_validation.ae")
        if rc1 != 0 { println("core: assemble_embed.sh (validation) failed"); return 1 }
        aether.shared_lib() {
            source("embed_validation.ae")
            extra_source("_embed_support.c")
            caps("extern")
            output("libphonenumber_ae_validation.so")
        }
    }
}
