// core.shortnumber — a pure-Aether ShortNumberInfo (the short/emergency-number
// side-library of libphonenumber).
//
// Compiled from resources/ShortNumberMetadata.xml (via core/gen/generate_short.ae)
// into core/shortnumber_metadata.ae. Answers the ShortNumberInfo surface:
// isPossibleShortNumber(ForRegion), isValidShortNumber(ForRegion),
// isEmergencyNumber / connectsToEmergencyNumber, isCarrierSpecific(ForRegion),
// isSmsServiceForRegion, and getExpectedCost(ForRegion).
//
// Short numbers are dialed as-is (no country code, no national prefix), so the
// input here is the raw short number and a region.

import std.string
import std.list
import std.regex
import core.shortnumber_metadata

exports(
    is_possible_short_number, is_valid_short_number,
    is_emergency_number, connects_to_emergency_number,
    is_carrier_specific, is_sms_service, expected_cost,
    short_example_number,
    // ShortNumberCost constants
    COST_TOLL_FREE, COST_STANDARD_RATE, COST_PREMIUM_RATE, COST_UNKNOWN
)

// ShortNumberCost.
const COST_TOLL_FREE = 0
const COST_STANDARD_RATE = 1
const COST_PREMIUM_RATE = 2
const COST_UNKNOWN = 3

// Field indices into a short-number metadata row.
const F_ID = 0
const F_GENERAL = 1
const F_LENGTHS = 2
const F_EXAMPLE = 3
const F_SHORT_CODE = 4
const F_TOLL_FREE = 5
const F_PREMIUM_RATE = 6
const F_STANDARD_RATE = 7
const F_CARRIER_SPECIFIC = 8
const F_SMS_SERVICES = 9
const F_EMERGENCY = 10

fn sep_char() -> int { return 31 }

fn dup(s: string) -> string { return string.concat(s, "") }

fn field(row: string, idx: int) -> string {
    sc = sep_char()
    start = 0
    seen = 0
    n = string.length(row)
    for (i = 0; i <= n; i++) {
        at = 0
        if i == n { at = 1 } else { if string.char_at(row, i) == sc { at = 1 } }
        if at == 1 {
            if seen == idx { return string.substring(row, start, i) }
            seen = seen + 1
            start = i + 1
        }
    }
    return ""
}

fn row_for(region: string) -> string {
    rows = shortnumber_metadata.rows()
    up = string.to_upper(region)
    out = ""
    n = list.size(rows)
    for (i = 0; i < n; i++) {
        r, _ = list.get(rows, i)
        if field(r, F_ID) == up { out = dup(r); break }
    }
    list.free(rows)
    return out
}

// Keep only digits.
fn digits(s: string) -> string {
    out = ""
    n = string.length(s)
    for (i = 0; i < n; i++) {
        c = string.char_at(s, i)
        if c >= 48 && c <= 57 { out = "${out}${string.substring(s, i, i + 1)}" }
    }
    return out
}

// full regex match, anchored (shared shape with the core engine).
fn full_match(pat: string, s: string) -> int {
    if string.length(pat) == 0 { return 0 }
    // std.regex compiled inline; import kept local to avoid a hard dep on the
    // core engine module.
    return regex_full(pat, s)
}

fn regex_full(pat: string, s: string) -> int {
    anchored = "^(?:${pat})$"
    re, err = regex.compile(anchored)
    if err != "" { return 0 }
    m = regex.matches(re, s)
    regex.free(re)
    if m == 1 { return 1 }
    return 0
}

// length spec check ("N" / "[lo-hi]" comma list).
fn length_ok(spec: string, len: int) -> int {
    if string.length(spec) == 0 { return 0 }
    start = 0
    n = string.length(spec)
    for (i = 0; i <= n; i++) {
        at = 0
        if i == n { at = 1 } else { if string.char_at(spec, i) == 44 { at = 1 } }
        if at == 1 {
            if token_matches(string.substring(spec, start, i), len) == 1 { return 1 }
            start = i + 1
        }
    }
    return 0
}

fn token_matches(tok: string, len: int) -> int {
    if string.length(tok) == 0 { return 0 }
    if string.char_at(tok, 0) == 91 {   // '['
        inner = string.substring(tok, 1, string.length(tok) - 1)
        dash = string.index_of(inner, "-")
        if dash < 0 {
            v, e = string.to_int(inner)
            if e == "" && v == len { return 1 }
            return 0
        }
        lo, le = string.to_int(string.substring(inner, 0, dash))
        hi, he = string.to_int(string.substring(inner, dash + 1, string.length(inner)))
        if le == "" && he == "" && len >= lo && len <= hi { return 1 }
        return 0
    }
    v, e = string.to_int(tok)
    if e == "" && v == len { return 1 }
    return 0
}

// --- public API ---

short_example_number(region: string) -> string {
    r = row_for(region)
    if r == "" { return "" }
    return field(r, F_EXAMPLE)
}

// isPossibleShortNumberForRegion: the number has a length the region's shortCode
// possible-lengths allow.
is_possible_short_number(region: string, input: string) -> int {
    r = row_for(region)
    if r == "" { return 0 }
    d = digits(input)
    return length_ok(field(r, F_LENGTHS), string.length(d))
}

// isValidShortNumberForRegion: the number matches the region's shortCode pattern.
is_valid_short_number(region: string, input: string) -> int {
    r = row_for(region)
    if r == "" { return 0 }
    d = digits(input)
    if length_ok(field(r, F_LENGTHS), string.length(d)) == 0 { return 0 }
    return full_match(field(r, F_SHORT_CODE), d)
}

// isEmergencyNumber (ForRegion): matches the emergency pattern exactly.
is_emergency_number(region: string, input: string) -> int {
    r = row_for(region)
    if r == "" { return 0 }
    return full_match(field(r, F_EMERGENCY), digits(input))
}

// connectsToEmergencyNumber: the number begins with / equals an emergency
// number (some devices strip trailing digits). Prefix-match on the emergency
// pattern is the faithful approximation.
connects_to_emergency_number(region: string, input: string) -> int {
    r = row_for(region)
    if r == "" { return 0 }
    pat = field(r, F_EMERGENCY)
    if string.length(pat) == 0 { return 0 }
    d = digits(input)
    // exact match, or the emergency number is a prefix of the input.
    if full_match(pat, d) == 1 { return 1 }
    re, err = regex.compile("^(?:${pat})")
    if err != "" { return 0 }
    caps, cerr = regex.captures(re, d)
    ok = 0
    if cerr == "" && caps != null { ok = 1; regex.captures_free(caps) }
    regex.free(re)
    return ok
}

is_carrier_specific(region: string, input: string) -> int {
    r = row_for(region)
    if r == "" { return 0 }
    return full_match(field(r, F_CARRIER_SPECIFIC), digits(input))
}

is_sms_service(region: string, input: string) -> int {
    r = row_for(region)
    if r == "" { return 0 }
    return full_match(field(r, F_SMS_SERVICES), digits(input))
}

// getExpectedCostForRegion: premium > standard > toll-free > unknown, matching
// upstream's precedence (a number can match more than one; the most expensive
// wins for safety).
expected_cost(region: string, input: string) -> int {
    r = row_for(region)
    if r == "" { return COST_UNKNOWN }
    d = digits(input)
    // must be a valid short number first.
    if is_valid_short_number(region, input) == 0 { return COST_UNKNOWN }
    if full_match(field(r, F_PREMIUM_RATE), d) == 1 { return COST_PREMIUM_RATE }
    if full_match(field(r, F_STANDARD_RATE), d) == 1 { return COST_STANDARD_RATE }
    if full_match(field(r, F_TOLL_FREE), d) == 1 { return COST_TOLL_FREE }
    return COST_UNKNOWN
}
