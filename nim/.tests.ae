// Nim binding tests (importc + a real link). Canonical aeb grammar (no
// shell-out): nim.test() compiles + runs the test files; the {.passL.} in
// nim/src/phonenumber_ae.nim points -L/-rpath at the engine, and the SDK walks
// deps for the shared_library_deps artifact so the linker + rpath resolve.
// Mirrors the selenium nim binding.
import bldr
import nim
import bldr (dep, dep_artifact)
import nim (test_file, nim_flag)

aeb(cap) {
    bldr.build() {
        prereq("nim")
        dep("core/.build.ae")
        nim.test() {
            nim_flag("--hints:off")
            nim_flag("--path:src")
            test_file("tests/tconformance.nim")
        }
    }
}
