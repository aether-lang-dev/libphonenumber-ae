// Rust binding tests (libloading). Canonical aeb grammar (no shell-out):
//   prereq                 — skip cleanly when rust is absent
//   env                    — engine .so path the libloading loader reads
//   rust.cargo_test_existing { extra("--offline") }
//                          — `cargo test` over the vendored Cargo.lock;
//                            --offline keeps it network-free. Mirrors the
//                            selenium binding's proven pattern.
import bldr
import rust
import bldr (dep, dep_artifact)
import rust (extra, env)

aeb(cap) {
    bldr.build() {
        prereq("rust:1.75")
        dep("core/.build.ae")
        lib = dep_artifact("core/.build.ae", "shared_lib")
        rust.cargo_test_existing() {
            env("LIBPHONENUMBER_AE_LIB", lib)
            extra("--offline")
        }
    }
}
