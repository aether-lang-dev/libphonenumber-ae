# Ignore build directories and any files generated by the update script.
cpp/build/
cpp/src/phonenumbers/geocoding/geocoding_data.cc
cpp/src/phonenumbers/phonemetadata.pb.*
cpp/src/phonenumbers/phonenumber.pb.*
cpp/test/phonenumbers/geocoding/geocoding_test_data.cc
java/build/
java/demo/war/WEB-INF/classes/
java/demo/war/WEB-INF/lib/
java/**/target/
# Ignore the logs directory
/logs/

# ---- Aether build artifacts ----
# Depth-agnostic globs: match these build/dep/output dirs and compiled
# artifacts wherever they appear under any binding.
/target/
**/.aeb/
**/target/
**/native/
**/node_modules/
**/_build/
**/build/
**/.dart_tool/
**/nimcache/
**/zig-out/
**/.zig-cache/
**/__pycache__/
**/*.egg-info/
**/bin/
**/obj/
# compiled native + bytecode artifacts, anywhere
**/*.so
**/*.dylib
**/*.dll
**/*.beam
**/*.class
# lockfiles that are regenerated by the toolchain (keep Cargo.lock — vendored)
**/pubspec.lock

# ---- generated metadata (build artifacts, derived from resources/) ----
# These .ae tables are produced by core/gen/generate_metadata.sh from the
# pristine in-tree resources/; they are NOT source. The build regenerates them.
core/metadata.ae
core/shortnumber_metadata.ae
core/timezone_metadata.ae
core/altformats_metadata.ae
core/carrier_metadata_*.ae
core/geocoder_metadata_*.ae
core/carrier_blobs.ae
core/geocoder_blobs.ae
# assembled embed variants (produced by core/gen/assemble_embed.sh)
core/embed.ae
core/embed_*.ae
