cabal-version:      2.4
name:               phonenumber-ae
version:            0.2.0.0
synopsis:           Validate, parse and format international phone numbers
description:
  A thin binding over the monorepo's ONE shared native engine
  (@core/native/libphonenumber_ae.so@, compiled from pure Aether over Google
  libphonenumber's metadata). It contains no phone-number logic: every function
  marshals to an @aether_pn_embed_*@ call across the flat C ABI described in
  @core/embed.ae@.
  .
  See @haskell/README.md@ for the ownership rule that matters when binding this
  ABI — caller-owned result strings.

license:            MIT
license-file:       ../LICENSE
author:             Paul Hammant
maintainer:         paul@hammant.org
category:           Text, Foreign
build-type:         Simple
extra-source-files: README.md

-- The dependency set is deliberately tiny: base and bytestring only, both of
-- which ship in a GHC installation. That is what lets `runghc` drive the test
-- suite with no `cabal update`, no network, and no package store — see
-- haskell/.tests.ae.

common warnings
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates
               -Wincomplete-uni-patterns -Wredundant-constraints

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:  PhoneNumber
                    PhoneNumber.Native
  build-depends:    base       >=4.14 && <5
                  , bytestring >=0.10 && <0.13
  default-language: Haskell2010

  -- We LINK the engine rather than dlopen it, so the shared library must exist
  -- at BUILD time as well as run time. `.tests.ae` stages the artifact into
  -- haskell/native/ before invoking the compiler; the second directory is the
  -- in-tree location for a plain `cabal build` after `aeb core/.build.ae`.
  extra-lib-dirs:   native
                  , ../core/native
  extra-libraries:  phonenumber_ae

  -- Bake both directories in as rpath so the produced binary finds the engine
  -- without LD_LIBRARY_PATH, matching how the other LINKED bindings (nim/, go/)
  -- do it. NOTE the field syntax: ld-options is a whitespace-separated token
  -- list, NOT the comma-separated list that extra-lib-dirs above is. Each
  -- -Wl,... must be one unbroken token.
  ld-options:       -Wl,-rpath,native -Wl,-rpath,../core/native

test-suite conformance
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Conformance.hs
  build-depends:    base
                  , bytestring
                  , phonenumber-ae
  default-language: Haskell2010
