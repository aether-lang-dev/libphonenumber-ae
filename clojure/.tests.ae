// Clojure binding tests. Canonical aeb grammar (no shell-out): clojure.run_main()
// loads the conformance namespace from source (no AOT) and runs its -main; the
// SDK puts java/.build.ae's classpath (the Java binding classes it calls) on the
// classpath. env() exports the engine .so path the NIF/Java layer dlopen's;
// skip_below_jdk keeps it off a pre-FFM (JDK < 22) runtime. Mirrors the selenium
// clojure binding.
import bldr
import clojure
import bldr (dep, dep_artifact)
import clojure (main_ns, env, skip_below_jdk, jvm_flag)

aeb(cap) {
    bldr.build() {
        prereq("jdk:22")
        dep("java/.build.ae")
        dep("core/.build.ae")
        lib = dep_artifact("core/.build.ae", "shared_lib")
        clojure.run_main() {
            env("LIBPHONENUMBER_AE_LIB", lib)
            main_ns("org.libphonenumber.ae.conformance-test")
            skip_below_jdk("22")
            jvm_flag("--enable-native-access=ALL-UNNAMED")
        }
    }
}
