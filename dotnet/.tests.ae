// .NET binding tests (P/Invoke). The resolver honors LIBPHONENUMBER_AE_LIB,
// which we point at the shared engine artifact this node deps.
//
// The conformance suite is a plain console runner (dotnet/test/Conformance.cs)
// rather than an xunit/NUnit project, so it needs no NuGet restore and runs
// offline. `dotnet run` returns the suite's own exit code.
//
// This node SKIPS LOUDLY (exit 0, a clear `dotnet: SKIPPED` line) when no
// `dotnet` is on PATH, or when the `dotnet` present is runtime-only with no
// SDK — rather than failing the DAG for a missing toolchain. On THIS box dotnet
// is not installed, so it skips.
import bldr
import std.os

aeb(cap) {
    bldr.build() {
        dep("core/.build.ae")
        lib = dep_artifact("core/.build.ae", "shared_lib")
        root = _get("root")

        have = os.system("command -v dotnet >/dev/null 2>&1")
        if have != 0 {
            println("dotnet: SKIPPED — dotnet not installed (no .NET SDK on PATH)")
            return 0
        }

        // A `dotnet` on PATH is not necessarily an SDK — the runtime-only
        // package provides the same binary but cannot build. Check before
        // committing to a failure.
        sdk = os.system("dotnet --list-sdks 2>/dev/null | grep -q .")
        if sdk != 0 {
            println("dotnet: SKIPPED — `dotnet` is present but no SDK is installed (runtime only)")
            return 0
        }

        // Neither project has a PackageReference, so this restore is offline and
        // local; --nologo keeps the log to the suite's own output.
        rc = os.system("cd \"${root}/dotnet\" && LIBPHONENUMBER_AE_LIB=\"${lib}\" DOTNET_NOLOGO=1 DOTNET_CLI_TELEMETRY_OPTOUT=1 dotnet run --project test/PhoneNumber.Tests.csproj -c Release --nologo")
        if rc != 0 {
            println("dotnet: conformance suite reported failures")
            return 1
        }
        println("dotnet: PASS — v6 conformance (parse, formats, AsYouType, matcher, ShortNumberInfo, TimeZones, Carrier, Geocoder; 45-check)")
        return 0
    }
}
