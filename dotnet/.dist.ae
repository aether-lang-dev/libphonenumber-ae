// The .NET binding's DISTRIBUTION artifact: a NuGet package (.nupkg) produced
// by `dotnet pack`, bundling the engine .so as a runtime/native asset.
//
// UNLIKE the tar-of-sources bindings, the idiomatic .NET artifact is a real
// .nupkg the SDK builds — which means it needs the .NET SDK. There is no honest
// hand-fake of a .nupkg (it is a specific zip layout + a generated .nuspec the
// SDK owns), so when the SDK is absent this node SKIPS LOUDLY: it prints the
// skip line, returns 0, and produces NO artifact — exactly the posture
// dotnet/.tests.ae already takes for the conformance run on this box.
//
// On THIS box dotnet is not installed, so it skips.
import bldr
import std.os
import bldr (dep, dep_artifact, _get)

aeb(cap) {
    bldr.build() {
        dep("core/.build.ae")
        lib = dep_artifact("core/.build.ae", "shared_lib")
        root = _get("root")

        have = os.system("command -v dotnet >/dev/null 2>&1")
        if have != 0 {
            println("dotnet dist: SKIPPED — dotnet not installed")
            return 0
        }

        // A `dotnet` on PATH is not necessarily an SDK — the runtime-only
        // package provides the same binary but cannot pack. Treat that as a
        // missing tool too.
        sdk = os.system("dotnet --list-sdks 2>/dev/null | grep -q .")
        if sdk != 0 {
            println("dotnet dist: SKIPPED — dotnet not installed")
            return 0
        }

        dist = "${root}/target/dist"
        _m = os.system("mkdir -p \"${dist}\"")

        // Stage the engine as a native asset next to the csproj so a pack that
        // bundles it under runtimes/<rid>/native/ finds it, then pack straight
        // into target/dist/.
        stage = "${root}/dotnet/src/native"
        _s = os.system("mkdir -p \"${stage}\"")
        cpl = os.system("cp \"${lib}\" \"${stage}/libphonenumber_ae.so\"")
        if cpl != 0 { println("dotnet dist: failed to stage the engine .so"); return 1 }

        rc = os.system("cd \"${root}/dotnet\" && DOTNET_NOLOGO=1 DOTNET_CLI_TELEMETRY_OPTOUT=1 dotnet pack src/PhoneNumber.csproj -c Release --nologo -o \"${dist}\"")
        if rc != 0 { println("dotnet dist: dotnet pack failed"); return 1 }
        println("dotnet dist: target/dist/*.nupkg (NuGet package, engine bundled as native asset)")
        return 0
    }
}
