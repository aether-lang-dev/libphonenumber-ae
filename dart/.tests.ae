// Dart binding tests (dart:ffi). Canonical aeb grammar (no shell-out):
//   prereq             — skip cleanly when dart is absent
//   dart.test { … }    — `dart pub get` (pub_get_first) then `dart test`,
//                        offline once the pub cache is warm; env() exports the
//                        engine .so path the dart:ffi loader reads.
// Mirrors the selenium binding's proven pattern.
import bldr
import dart
import bldr (dep, dep_artifact)
import dart (env, pub_get_first, offline, test_path, test_flag)

aeb(cap) {
    bldr.build() {
        prereq("dart")
        dep("core/.build.ae")
        lib = dep_artifact("core/.build.ae", "shared_lib")
        dart.test() {
            env("LIBPHONENUMBER_AE_LIB", lib)
            pub_get_first("1")
            offline("1")
            test_path("test/conformance_test.dart")
            // failures-only suppresses per-test lines; the SDK's count parser
            // otherwise mis-reads the '-' in test names ("trunk-prefix",
            // "as-you-type") as a failed-count marker -> false FAIL despite the
            // suite passing. (aeb parser bug, filed as an ask.)
            test_flag("--reporter=failures-only")
        }
    }
}
