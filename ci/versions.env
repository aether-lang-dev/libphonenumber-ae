# Pinned Aether toolchain versions — the single place to bump.
#
# aeb tags are "later means later" markers, NOT semver promises; pin them so a
# fresh clone (bootstrap.sh) and CI install the exact tested toolchain instead of
# whatever "latest" happens to be that day. bootstrap.sh sources this file;
# override at the shell to test a bump (e.g. `AEB_REF=v0.313 ./bootstrap.sh`).
#
# Keep the pair MATCHED: aeb builds its own tools (and compiles the generated node
# files) with the ae it pins, so AETHER_REF must be >= the ae that AEB_REF pins,
# or `aeb <node>` fails at type-check / import resolution.

# The Aether compiler (`ae`). Tag vX.Y.Z, branch, or commit SHA.
#
# 0.677.0 is what aeb v0.312 pins (AETHER_PIN/AETHER_FETCH, a floor). Install trap
# seen on this box: the aether installer defaults to ~/.aether/bin, which
# ~/.local/bin/ae can shadow on PATH — so `ae --version` may report the older
# binary after an install. Fix: put ~/.aether/bin ahead on PATH, or copy the new
# ae over the shadowing one, then reinstall aeb so its tools rebuild against it.
# Verified on ae 0.677.0 + aeb v0.312: clean core build + full `aeb .presubmit.ae`
# green (all engine gates + every binding; python — the node that the v0.311 bug
# had blocked — 43/43).
#
# Raised 0.677.0 -> 0.681.0 (2026-09-17), coupled to AEB_REF v0.313 (which pins a
# 0.680.0 floor; the installer landed the newer 0.681.0 and it works). This time
# the install put the right ae on PATH cleanly — no shadowing fix needed. Verified
# on ae 0.681.0 + aeb v0.313: clean core build + full presubmit green.
AETHER_REF=v0.681.0

# Hard floor: the OLDEST ae this port is known to build/pass on. bootstrap.sh
# rejects an already-on-PATH ae below this (installs the pin instead), so a box
# with a stale ae can't silently produce a bad build. os.arch() (aether #2051)
# and the E0200 narrowing rules the core relies on both require 0.681.0, so that
# is the floor — never below the pin. Bump this (not just AETHER_REF) when the
# port starts depending on a newer ae feature.
AETHER_MIN=0.681.0

# The aeb build runner. Tag v0.NNN, branch, or commit SHA.
#
# History relevant to this repo:
#   v0.307  java.package_jar from_classes() — java/.jar.ae packages java/.build.ae's
#           tested classes instead of recompiling ("tested == shipped" structural).
#   v0.310  python pip()/requirements_file() at top level fail loud (the root cause
#           there was ours — pip() is a block setter of install(); fixed in
#           python/.tests.ae). Green pair with ae 0.668.0.
#   v0.311  BLOCKER for us — its native-mtime SDK refactor shipped `_dir_newest_mtime`
#           with an un-annotated `newest = 0` (32-bit) taking a 64-bit fs.mtime, which
#           ae 0.675.0's E0200 narrowing check rejects; every .tests.ae importing an
#           affected SDK (python/dart/gleam/…) failed to type-check. Filed
#           ../aeb/asks/v0311-dir-newest-mtime-fails-e0200-narrowing-under-ae-0675.md.
#           DO NOT pin v0.311.
#   v0.312  FIXES the v0.311 blocker (1415206) and adds a cold-compile gate for SDK
#           modules (d4c49ad) so it can't recur. Pins ae 0.677.0 (coupled — see above).
#           Verified green here on the pair.
#   v0.313  generate_manifest across most SDKs (emit a consumer manifest — pubspec/
#           go.mod/mix.exs/… + the native edge) and --overrideDep (point a dep at a
#           prebuilt tree).
#   v0.315  _fetch_verified (pure-stdlib download + sha256 verify + cache — the
#           mechanism get-core.sh hand-rolls); bldr._host_arch() now uses os.arch()
#           (no uname -m); more --overrideDep. Pins ae 0.681.0. Verified green here on
#           ae 0.681.0 + aeb v0.315: clean core build + full presubmit.
#   v0.316  FIXES the os_arch_raw link bug (a node importing std.os and calling
#           os.arch() failed the fan-out link with `undefined reference to
#           os_arch_raw`; v0.315 and the dev builds between it and v0.316 all had
#           it — see ../aeb/asks/os-arch-raw-unlinked-in-fanout-node.md). This
#           UNBLOCKS core/.getFromGitHub.ae (the pure-Aether prebuilt-core fetch
#           node): on v0.316 it links and runs, so get-core.sh can retire. NOTE:
#           get.sh source-builds a dev aeb here instead of landing the tag —
#           install the v0.316 RELEASE BINARY (aeb-<os>-<arch>.tar.gz + its
#           install.sh) to get a clean tagged aeb. Verified: clean core build +
#           fetch node links (fails only for want of a published release asset).
#   v0.317  Pins ae 0.695.0 (FETCH-side lockstep — the ae that best consumes ae-add
#           binary packages; the #2099/#2106 round trip) and adds
#           aether.emit_binary_package: an aeb SDK builder that PRODUCES an `ae add
#           binary`-consumable package (bare per-triple .so + a binary=/modules="."
#           aether.toml + sidecars) — the canonical producer of exactly the shape
#           release/build.sh currently hand-rolls. Worth evaluating to replace the
#           hand-rolled aether.toml emission (canonical-grammar-no-shell-out goal).
#           aeb still compiles on the 0.681 floor (no new primitive); the pin moves
#           with FETCH. Install the RELEASE BINARY (compiler-free bundle + install.sh
#           + .sha256), NOT get.sh (which source-builds a dev aeb). Verified here on
#           ae 0.695.0 + aeb v0.317: clean core build + full presubmit.
AEB_REF=v0.317
