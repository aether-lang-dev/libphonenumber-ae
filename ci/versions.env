# Pinned toolchain versions — the single place to bump.
#
# aeb tags are "later means later" markers, NOT semver promises; pin them so a
# run is reproducible. Override at the shell to test a bump
# (e.g. `AETHER_REF=v0.897.0 aeb .presubmit.ae`).

# ---- Aether engine toolchain ----

# The Aether compiler (`ae`). Tag vX.Y.Z, branch, or commit SHA. The engine
# uses std.xml (offline generator) and std.regex (PCRE2, for isValidNumber).
# Pinned to 0.897.0 — verified 2026-11-07: every core_tests gate on macOS arm64
# and in a full `aeb .presubmit.ae` on cachyos (x86_64 Linux), plus every
# binding whose toolchain was present there (see the commit that moved this
# pin). 0.897.0 is also the floor: nothing between 0.653.0 and it was tested.
# What the engine needs from a newer ae, for whoever wants to lower it with
# evidence:
#   - `--emit=lib` refusing externs without `--with=extern` (core/.build.ae,
#     core/validation.build.ae pass caps("extern"); the composable-build
#     command lines pass --with=extern);
#   - an extern/export declared `-> string` meaning a counted Aether string,
#     so pn_raw_dup and every string-returning pn_embed_* are `-> ptr`;
#   - `list.get` handing back a `ptr` (no implicit string reading), so the
#     engine and generators read string lists with `list.get_string`.
# Install as a consistent set — a get.sh binary install pairs the driver with
# a matching libaether.a.
AETHER_REF=v0.897.0

# The aeb build runner. Tag v0.NNN, branch, or commit SHA. v0.342 — the current
# release, verified with ae 0.897.0 (v0.341 on the full runs above; v0.342 adds
# only the no-marker root fallback below, checked by building core/.build.ae
# from a `git archive` extract with the released v0.342). (Since v0.301 it
# carries the zig-cc fallback: on a box with no gcc/cc/$CC, `aeb <node>.build.ae` fetches a
# pinned zig (0.16.0) into ~/.cache/aeb/zig once, sets AE_CC="zig cc", prints one
# line, and builds — so bootstrap.sh is one command to a green engine build even
# with no system compiler. (Opt out: AEB_NO_ZIG=1.) Floors still apply: >= v0.298
# make-free binary-first installer; >= v0.287 so a .tests.ae node's non-zero
# return reddens the build; >= v0.342 so a `git archive` or GitHub tarball
# extract (no .git/.aeb marker) builds: the project root for module imports
# such as `import core.phonenumber` falls back to the directory aeb runs in.)
AEB_REF=v0.342

# ---- BEAM family (erlang, elixir, gleam bindings) ----
# Floor OTP 27 + Elixir 1.20 (older OTP's escript rejects gleam_stdlib syntax).
OTP_REF=27
ELIXIR_REF=1.20.4

# ---- Other language toolchains (floors the bindings assume) ----
# JVM family (java/kotlin/scala/clojure/groovy): JDK 22+ for the FFM/Panama
#   binding (java.lang.foreign is final in 22). node 18+, go 1.22+ — as each
#   binding's .tests.ae prereqs declare. Zig 0.17.0+ for zig/ (its build.zig
#   uses the 0.17 build API; zig/build.zig.zon minimum_zig_version), verified
#   on 0.17.1 (macOS) and 0.17.0 (cachyos).
