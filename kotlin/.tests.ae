// Kotlin binding tests. Canonical aeb grammar (no shell-out): kotlinc compiles
// the maven-layout sources against java/.build.ae's classes (on the classpath via
// the dep), and kotlin_test runs the ConformanceTest main. env() exports the
// engine .so path; skip_below_jdk keeps it off a pre-FFM runtime. Needs a real
// kotlinc >= 2.x (Debian's 1.3 can't emit/read FFM bytecode) — provide it via
// KOTLIN_HOME. Mirrors the selenium kotlin binding.
import bldr
import kotlin
import bldr (dep, dep_artifact)
import kotlin (source_layout, env, skip_below_jdk, jvm_args)

aeb(cap) {
    bldr.build() {
        prereq("jdk:22")
        dep("java/.build.ae")
        dep("core/.build.ae")
        lib = dep_artifact("core/.build.ae", "shared_lib")
        kotlin.kotlinc() {
            source_layout("maven idiomatic")
        }
        kotlin.kotlinc_test() {
            source_layout("maven idiomatic")
        }
        kotlin.kotlin_test("org.libphonenumber.ae.kotlin.ConformanceTest") {
            env("LIBPHONENUMBER_AE_LIB", lib)
            skip_below_jdk("22")
            jvm_args("--enable-native-access=ALL-UNNAMED")
        }
    }
}
