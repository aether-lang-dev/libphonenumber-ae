// Erlang binding tests (the canonical BEAM NIF), as EUnit. Canonical aeb grammar
// (no shell-out): erlang.eunit() compiles + runs the eunit suite against the NIF
// app built by erlang/.build.ae (its erl_libs / nif_ebin artifacts), with env()
// exporting ERL_LIBS + the engine .so path the NIF dlopen's. Mirrors the
// selenium erlang binding.
import bldr
import erlang
import bldr (dep, dep_artifact)
import erlang (env, test_source, run_main, pa)

aeb(cap) {
    bldr.build() {
        prereq("erlang")
        dep("core/.build.ae")
        dep("erlang/.build.ae")
        lib  = dep_artifact("core/.build.ae", "shared_lib")
        libs = dep_artifact("erlang/.build.ae", "erl_libs")
        ebin = dep_artifact("erlang/.build.ae", "nif_ebin")
        erlang.eunit() {
            env("ERL_LIBS", libs)
            env("LIBPHONENUMBER_AE_LIB", lib)
            test_source("test/phonenumber_ae_conformance_SUITE.erl")
            pa(ebin)
            run_main("phonenumber_ae_conformance_SUITE")
        }
    }
}
