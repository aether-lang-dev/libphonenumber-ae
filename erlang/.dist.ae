// The Erlang binding's DISTRIBUTION artifact: a tarball of the OTP application.
//
// Unlike erlang/.build.ae (which compiles the canonical BEAM NIF into the app
// under erlang/_build/phonenumber_ae_nif for the in-repo test/BEAM family to run
// against), this node produces a hand-to-someone tarball under target/dist/: the
// whole OTP app — ebin/ (the compiled .beam + .app) plus priv/, with the engine
// .so vendored under priv/ alongside the NIF .so.
//
// The BEAM idiom for "here is my app, unpack it onto ERL_LIBS" is a tar of the
// application directory. erlang/.build.ae already stages the freshly-built
// engine into priv/phonenumber_ae_nif's priv/libphonenumber_ae.so (next to the
// NIF phonenumber_ae_nif.so), so the tarball is self-contained: the NIF's load
// callback finds the engine in priv/ with no external .so to place.
//
// One .so per tarball => current-OS-only (the .so is this box's platform), same
// caveat as the fat jar. A missing Erlang/OTP toolchain is a first-class SKIP:
// without erl/erlc the app never compiles, so there is nothing to package.
import bldr
import std.os
import bldr (dep, dep_artifact, _get)

aeb(cap) {
    bldr.build() {
        // A tarball with no compiled app is not a distribution. If the Erlang
        // toolchain is absent the app cannot have been built, so skip loudly —
        // return 0, produce no artifact — exactly like the test node does.
        have = os.system("command -v erl >/dev/null 2>&1 && command -v erlc >/dev/null 2>&1")
        if have != 0 {
            println("erlang dist: SKIPPED — erl not installed (no Erlang/OTP on PATH)")
            return 0
        }

        dep("core/.build.ae")
        dep("erlang/.build.ae")
        root = _get("root")
        dist = "${root}/target/dist"
        _m = os.system("mkdir -p \"${dist}\"")

        // erlang/.build.ae skips (rather than fails) when erl_nif.h is missing,
        // so the app may legitimately not exist. Without the compiled app there
        // is nothing to package — that is an environment gap, not a failure.
        app = "${root}/erlang/_build/phonenumber_ae_nif"
        built = os.system("test -f \"${app}/priv/phonenumber_ae_nif.so\"")
        if built != 0 {
            println("erlang dist: SKIPPED — NIF not built (erl_nif.h missing? install erlang-dev)")
            return 0
        }

        // Tar the whole OTP app directory (ebin/ + priv/, engine .so vendored in
        // priv/ by the build). -C the app's PARENT so the archive expands to a
        // top-level phonenumber_ae_nif/ ready to drop onto ERL_LIBS.
        rc = os.system("tar -czf \"${dist}/phonenumber-ae-erlang.tar.gz\" -C \"${root}/erlang/_build\" phonenumber_ae_nif")
        if rc != 0 { println("erlang dist: failed to build the app tarball"); return 1 }
        println("erlang dist: target/dist/phonenumber-ae-erlang.tar.gz (OTP app, engine .so vendored under priv/)")
        return 0
    }
}
