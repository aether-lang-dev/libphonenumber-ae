%% OTP application resource for the canonical BEAM binding.
%%
%% The app is named after the NIF rather than the friendly module because it
%% is the ARTIFACT the other two BEAM bindings consume: elixir/ and gleam/ put
%% this app's directory on ERL_LIBS and load the very same compiled
%% phonenumber_ae_nif.beam + priv/phonenumber_ae_nif.so. One NIF, three
%% languages.
%%
%% No `mod` key: there is no supervision tree to start. The engine is a pure
%% stateless transform, so nothing here needs an application controller.
{application, phonenumber_ae_nif,
 [{description, "libphonenumber NIF over the shared Aether engine (canonical BEAM binding)"},
  {vsn, "0.1.0"},
  {registered, []},
  {applications, [kernel, stdlib]},
  {modules, [phonenumber_ae, phonenumber_ae_nif]},
  {env, []}
 ]}.
