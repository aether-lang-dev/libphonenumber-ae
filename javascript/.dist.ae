// The JavaScript (Node) binding's DISTRIBUTION artifact: a self-contained npm
// tarball, built with canonical aeb grammar (no shell-out).
//
//   copy.file       — vendor the freshly-built engine .so into javascript/native/
//                     (package.json's files glob includes native/, so npm packs
//                     it in; the koffi loader in lib/native.js probes native/
//                     beside the package, so the tarball runs with no external .so
//                     and no LIBPHONENUMBER_AE_LIB).
//   javascript.pack — `npm pack` -> phonenumber_ae-<version>.tgz; publishes the
//                     tarball_dir artifact.
//
// The engine .so comes from core/.build.ae's shared_lib artifact (dep'd), so the
// tarball always vendors the freshly-built engine. One .so per tarball =>
// current-OS-only.
import bldr
import javascript
import copy
import bldr (dep, dep_artifact)
import copy (from, to)

aeb(cap) {
    bldr.build() {
        dep("core/.build.ae")
        lib = dep_artifact("core/.build.ae", "shared_lib")

        // Vendor the engine into the package's native/ dir.
        copy.file() {
            from(lib)
            to("native/libphonenumber_ae.so")
        }

        // Pack the npm tarball (writes phonenumber_ae-<version>.tgz, publishes
        // the tarball_dir artifact for the aggregator to collect).
        javascript.pack() {
        }
    }
}
