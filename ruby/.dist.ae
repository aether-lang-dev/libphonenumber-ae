// The Ruby binding's DISTRIBUTION artifact: a self-contained gem, built with
// canonical aeb grammar (no shell-out).
//
//   copy.file  — vendor the freshly-built engine .so into ruby/native/ (the
//                gemspec's files glob native/*.so packages it into the gem, so
//                the gem runs with no external .so / no LIBPHONENUMBER_AE_LIB).
//   ruby.gem   — `gem build phonenumber_ae.gemspec`; writes the .gem into this
//                module's target/dist/ and publishes the "gem_dir" artifact.
//
// The engine .so comes from core/.build.ae's shared_lib artifact (dep'd), so the
// gem always vendors the freshly-built engine. One .so per gem => current-OS-only.
//
// NOTE (aeb gaps, filed as asks in ../aeb/asks/):
//   - ruby.gem has no loud-skip-when-gem-absent (it hard-fails); Ruby is present
//     on this box.
//   - the built gem lands in this module's target/dist/; collecting every
//     binding's artifact into the monorepo's single root target/dist/ has no
//     canonical builder (a downstream node can't dep_artifact the node it is).
//     The root .dist aggregator gathers gem_dir artifacts instead of a shell cp.
import bldr
import ruby
import copy
import bldr (dep, dep_artifact)
import ruby (build)
import copy (from, to)

aeb(cap) {
    bldr.build() {
        dep("core/.build.ae")
        lib = dep_artifact("core/.build.ae", "shared_lib")

        // Vendor the engine into the gem's native/ dir.
        copy.file() {
            from(lib)
            to("native/libphonenumber_ae.so")
        }

        // Build the gem (writes target/dist/phonenumber_ae-<version>.gem,
        // publishes the gem_dir artifact for the aggregator to collect).
        ruby.gem() {
            build("phonenumber_ae.gemspec")
        }
    }
}
