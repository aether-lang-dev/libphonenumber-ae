// Ruby binding tests (Fiddle). Canonical aeb grammar: ruby.bundle() resolves the
// Gemfile (rspec lives there) and runs rspec; env() exports the engine .so path
// the Fiddle loader reads (LIBPHONENUMBER_AE_LIB), pointed at the shared artifact
// this node deps. No shell-out — the SDK handles gem/bundler resolution and the
// env export.
//
// NOTE (aeb gap): the ruby SDK has no loud-skip-when-toolchain-absent — it falls
// back to a bare `ruby`/`bundle` and hard-fails if absent, rather than skipping.
// Ruby is present on this box so the suite runs; a clean skip when Ruby is
// missing is filed as an aeb ask (see ../aeb/asks/).
import bldr
import ruby
import bldr (dep, dep_artifact)
import ruby (install, rspec, rspec_arg, env)

aeb(cap) {
    bldr.build() {
        dep("core/.build.ae")
        lib = dep_artifact("core/.build.ae", "shared_lib")
        ruby.bundle() {
            install()
            rspec()
            rspec_arg("--format")
            rspec_arg("progress")
            env("LIBPHONENUMBER_AE_LIB", lib)
        }
    }
}
