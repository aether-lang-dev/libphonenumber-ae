# frozen_string_literal: true

# The engine lives in ../target/build/core/lib; point the loader at it for
# in-tree runs unless the caller (aeb, CI) already set LIBPHONENUMBER_AE_LIB.
ENV["LIBPHONENUMBER_AE_LIB"] ||= begin
  candidate = File.expand_path("../target/build/core/lib/libphonenumber_ae.so", __dir__)
  File.exist?(candidate) ? candidate : nil
end

begin
  require "rspec/core/rake_task"
  RSpec::Core::RakeTask.new(:spec)
rescue LoadError
  desc "spec (rspec is not installed)"
  task :spec do
    abort "rspec is not installed — `gem install rspec` (or `bundle install`) first."
  end
end

desc "Stage the engine into ruby/native/ so the built gem bundles it"
task :stage_native do
  root = File.expand_path("..", __dir__)
  src = "#{root}/target/build/core/lib/libphonenumber_ae.so"
  require "fileutils"
  FileUtils.mkdir_p("#{__dir__}/native")
  FileUtils.cp(src, "#{__dir__}/native/")
end

task default: :spec
