// The Zig binding's DISTRIBUTION artifact: a .tar.gz of the Zig module.
//
// Mirrors java/.jar.ae in shape: dep core/.build.ae, take its freshly-built
// engine .so via dep_artifact, and assemble a hand-to-someone package under
// target/dist/. Zig has no binary package registry format the way a jar or a
// nupkg is; the idiomatic distributable is the module source tree (build.zig,
// build.zig.zon, src/) that a consumer references via the Zig package manager.
// We vendor the engine .so under native/ so the binding links and runs on a
// box that never built the engine — build.zig's third resolution step searches
// zig/native for the library.
//
// A consumer normally builds the .so from FFI at their end, but bundling the
// current-box .so makes this a self-contained, ready-to-run package (same
// spirit as the fat jar). One .so per package => current-OS-only.
import bldr
import bldr (dep, dep_artifact, _get)
import std.os

aeb(cap) {
    bldr.build() {
        dep("core/.build.ae")
        lib = dep_artifact("core/.build.ae", "shared_lib")
        root = _get("root")
        dist = "${root}/target/dist"
        _m = os.system("mkdir -p \"${dist}\"")

        // Vendor the freshly-built engine into zig/native — build.zig's third
        // library-resolution step searches exactly this directory.
        dest = "${root}/zig/native"
        _md = os.system("mkdir -p \"${dest}\"")
        cp = os.system("cp -f \"${lib}\" \"${dest}/libphonenumber_ae.so\"")
        if cp != 0 { println("zig dist: could not vendor the engine into zig/native"); return 1 }

        out = "${dist}/phonenumber-ae-zig.tar.gz"

        // tar the module sources plus the vendored engine .so. Plain tar — the
        // idiomatic Zig distributable is a source tarball, no toolchain needed.
        rc = os.system("cd \"${root}/zig\" && tar -czf \"${out}\" build.zig build.zig.zon src example README.md native/libphonenumber_ae.so")
        if rc != 0 { println("zig dist: failed to build the module tarball"); return 1 }
        println("zig dist: target/dist/phonenumber-ae-zig.tar.gz (Zig module, engine vendored at native/)")
        return 0
    }
}
