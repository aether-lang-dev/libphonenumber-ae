// Zig binding tests. Canonical aeb grammar (no shell-out): zig.test() runs the
// `zig test` blocks (src/conformance.zig via src/root.zig). Zig LINKS the engine
// (build.zig turns the dep into a -L search path + rpath), and the SDK walks
// deps for the shared_library_deps artifact so the link resolves. Mirrors the
// selenium zig binding.
import bldr
import zig
import bldr (dep)

aeb(cap) {
    bldr.build() {
        prereq("zig")
        dep("core/.build.ae")
        zig.test() {
        }
    }
}
